component CruiseController
  "Target speed [km/h]"
  u_s = RealInput()

  "Measured road speed [km/h]"
  u_m = RealInput()

  "Driver effort: positive accelerates, negative brakes"
  y = RealOutput()

  "Controller gain for pedal/brake effort"
  parameter k::Real = 0.14

  "Integral time [s]"
  parameter Ti::Time = 3.5

  "Derivative time [s]"
  parameter Td::Time = 0.7

  "Derivative filter factor"
  parameter Nd::Real = 10

  "Zero means derivative acts on measured speed only"
  parameter wd::Real = 0

  "Initial integral state"
  parameter xi0::Real = 0

  "Initial derivative-filter state: start from rest"
  parameter xd0::Real = 0

  "Maximum accelerator effort"
  parameter y_max::Real = 1

  "Maximum braking effort"
  parameter y_min::Real = -1

  error = BlockComponents.Math.Add(k1 = 1, k2 = -1)

  add_d = BlockComponents.Math.Add(k1 = wd, k2 = -1)
  derivative = BlockComponents.Continuous.Derivative(
    k = Td,
    T = Td / Nd,
    x0 = xd0
  )

  integrator = BlockComponents.Continuous.Integrator(
    k = 1 / Ti,
    x0 = xi0
  )

  add_pid = BlockComponents.Math.Add3(
    k1 = 1,
    k2 = 1,
    k3 = 1
  )

  gain = BlockComponents.Math.Gain(k = k)

  limiter = BlockComponents.Nonlinear.Limiter(
    y_min = y_min,
    y_max = y_max
  )

  "Difference between requested and permitted effort"
  excess = BlockComponents.Math.Add(k1 = 1, k2 = -1)

  "Check whether error pushes further into saturation"
  push = BlockComponents.Math.Product()
  winding = BlockComponents.Logical.GreaterThreshold(threshold = 0)

  zero = BlockComponents.Sources.Constant(k = 0.0)
  gate = BlockComponents.Logical.Switch()

relations
  connect(u_s, error.u1)
  connect(u_m, error.u2)

  connect(error.y, add_pid.u1)
  connect(integrator.y, add_pid.u3)

  connect(u_s, add_d.u1)
  connect(u_m, add_d.u2)
  connect(add_d.y, derivative.u)
  connect(derivative.y, add_pid.u2)

  connect(add_pid.y, gain.u)
  connect(gain.y, limiter.u)
  connect(limiter.y, y)

  connect(gain.y, excess.u1)
  connect(limiter.y, excess.u2)
  connect(excess.y, push.u1)
  connect(error.y, push.u2)
  connect(push.y, winding.u)

  connect(zero.y, gate.u1)
  connect(winding.y, gate.u2)
  connect(error.y, gate.u3)
  connect(gate.y, integrator.u)
end