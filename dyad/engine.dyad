"Engine model with transport delay, gradual torque buildup and a torque limit."
component Engine
  "Limits delivered torque to the range 0 to T_max."
  limiter = BlockComponents.Nonlinear.Limiter(y_max = T_max, y_min = 0) {^limiter}

  "Output shaft: connects the engine to the rotating load or driveline."
  spline = Dyad.Spline() {^spline}

  "Engine housing connection: transfers reaction torque to the mounting."
  support = Dyad.Spline() {^support}

  "First-order lag: represents gradual torque buildup due to manifold filling."
  lag = BlockComponents.Continuous.FirstOrder(T = tau_e) {^lag}

  "Input signal: requested engine torque in N·m."
  tau_cmd = Dyad.RealInput() {^tau_cmd}

  "Approximates the transport delay between the torque request and engine response."
  delay = BlockComponents.Nonlinear.PadeDelay(n = 6, m = 5, delayTime = theta_e) {^delay}

  "Applies the calculated mechanical torque between the output shaft and housing."
  torque = RotationalComponents.Sources.TorqueSource() {^torque}

  "Transport delay in seconds; fixed when the model is compiled."
  structural parameter theta_e::Time = 0.3

  "Torque buildup time constant in seconds."
  parameter tau_e::Time = 0.3

  "Maximum available engine torque in N·m."
  parameter T_max::Torque = 150

relations
  connect(delay.y, lag.u) {^id8}
  connect(lag.y, limiter.u) {^id9}
  connect(limiter.y, torque.tau) {^id10}
  connect(torque.support, support) {^id11}
  connect(torque.spline, spline) {^id12}
  connect(delay.u, tau_cmd) {^id13}

