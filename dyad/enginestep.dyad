"short EngineStep component description"
component EngineStep
  engine = mycar.Engine() {^engine}
  cmd = BlockComponents.Sources.Step(height = 200, start_time = 0.5, offset = 0) {^cmd}
  load = RotationalComponents.Components.Inertia(J = 1, phi(initial = 0), w(initial = 0)) {^load}
  mounts = RotationalComponents.Components.Fixed() {^mounts}
relations
  connect(cmd.y, engine.tau_cmd) {^id5}
  connect(load.spline_a, engine.spline) {^id6}
  connect(mounts.spline, engine.support) {^id7}
  initial engine.lag.x = 0
metadata {
  "Dyad": {
    "experiments": {},
    "tests": {},
    "labels": [
      {
        "label": "$(instance)",
        "x": 500,
        "y": 1100,
        "rot": 0,
        "layer": "icon",
        "attrs": {}
      }
    ],
    "icons": {"default": "dyad://Dyad/Default.svg"},
    "path": {},
    "doc": {"behavior": true},
    "deprecated": null,
    "panel": {}
  },
  "_links": {
    "engine": {
      "Dyad": {"placement": {"diagram": {"x1": 350, "x2": 450, "y1": 450, "y2": 550}}}
    },
    "cmd": {
      "Dyad": {"placement": {"diagram": {"x1": 50, "x2": 150, "y1": 450, "y2": 550}}}
    },
    "load": {
      "Dyad": {"placement": {"diagram": {"x1": 610, "x2": 710, "y1": 450, "y2": 550}}}
    },
    "mounts": {
      "Dyad": {"placement": {"diagram": {"x1": 350, "x2": 450, "y1": 720, "y2": 820}}}
    },
    "id5": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}},
    "id6": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}},
    "id7": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  }
}
end