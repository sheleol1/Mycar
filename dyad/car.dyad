"Car on a flat road: requested engine torque in, vehicle speed in km/h out."
component Car
  "Requested engine torque in N·m."
  tau_cmd = Dyad.RealInput() {^tau_cmd}
  "Measured vehicle speed in km/h."
  v_kmh = Dyad.RealOutput() {^v_kmh}
  "Engine with transport delay, gradual response and torque limitation."
  engine = mycar.Engine() {^engine}
  "Gearbox and ideal rolling wheel: converts shaft torque into driving force."
  driveline = mycar.Driveline() {^driveline}
  "Vehicle mass with aerodynamic drag and rolling resistance."
  body = mycar.Body() {^body}
  "Measures the body's straight-line velocity in m/s."
  vsensor = TranslationalComponents.Sensors.VelocitySensor() {^vsensor}
  "Converts velocity from m/s to km/h."
  to_kmh = BlockComponents.Math.Gain(k = 3.6) {^to_kmh}
  "Fixed rotational reference for the engine housing and driveline supports."
  rot_ground = RotationalComponents.Components.Fixed() {^rot_ground}
  "Fixed translational reference representing the road beneath the wheel."
  trans_ground = TranslationalComponents.Components.Fixed() {^trans_ground}
relations
  connect(tau_cmd, engine.tau_cmd) {^id10}
  connect(engine.spline, driveline.spline) {^id11}
  connect(driveline.support_t, trans_ground.flange) {^id13}
  connect(vsensor.flange, body.flange, driveline.flange) {^id14}
  connect(vsensor.v, to_kmh.u) {^id15}
  connect(to_kmh.y, v_kmh) {^id16}
  connect(rot_ground.spline, engine.support, driveline.support_r) {^id17}
