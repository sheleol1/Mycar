component PedalStop
  "Foot force as a fraction of 500 N"
  parameter pedal::Real = 0.6
  "Road grip: 1 dry, 0.5 wet, 0.3 snow"
  parameter road_mu::Real = 1.0
  "Apply the brake at 0.5 seconds"
  command = BlockComponents.Sources.Step(height = pedal, offset = 0, start_time = 0.5) {^command}
  road = BlockComponents.Sources.Constant(k = road_mu) {^road}
  "Pedal lever multiplies the driver's foot force"
  pedal_unit = VehicleSystemsComponents.Vehicle.Brake.BrakePedal() {^pedal_unit}
  "Vacuum booster adds braking assistance"
  booster = VehicleSystemsComponents.Vehicle.Brake.StaticBooster() {^booster}
  "Convert pushrod force into hydraulic pressure"
  master = VehicleSystemsComponents.Vehicle.Brake.TandemMasterCylinder() {^master}
  "Front and rear hydraulic lines"
  line_f = VehicleSystemsComponents.Vehicle.Brake.BrakeLine() {^line_f}
  line_r = VehicleSystemsComponents.Vehicle.Brake.BrakeLine(L = 4.0) {^line_r}
  "Equivalent wheel with front and rear brake calipers"
  wheel = VehicleSystemsComponents.Vehicle.Wheel.HydraulicBrakedWheel() {^wheel}
  body = Body() {^body}
  speed = TranslationalComponents.Sensors.VelocitySensor() {^speed}
  "Fixed supports for brake housings"
  fixed = RotationalComponents.Components.Fixed() {^fixed}
  fixed_hydraulic = TranslationalComponents.Components.Fixed() {^fixed_hydraulic}
  "Brake fluid: bulk modulus [Pa] and density [kg/m³]"
  path medium::HydraulicComponents.Interfaces.AbstractMedium = HydraulicComponents.IsothermalCompressible(bulk_modulus = 1.4e9, density = 1045.0, let_gas = false)
relations
  connect(command.y, pedal_unit.u) {^id13}
  connect(pedal_unit.rod, booster.input) {^id14}
  connect(booster.rod_out, master.pushrod) {^id15}
  connect(pedal_unit.support, booster.support, master.support, fixed_hydraulic.flange) {^id16}
  connect(master.front, line_f.port_a) {^id17}
  connect(line_f.port_b, wheel.front) {^id18}
  connect(master.rear, line_r.port_a) {^id19}
  connect(line_r.port_b, wheel.rear) {^id20}
  continuity(medium, master.front.medium)
  connect(road.y, wheel.mu_scale) {^id21}
  connect(wheel.support, fixed.spline) {^id22}
  connect(wheel.flange, body.flange, speed.flange) {^id23}
  "Start with the wheel rolling at 90 km/h"
  initial wheel.inertia.phi = 0
  initial wheel.inertia.w = 25 / 0.31
  initial body.mass.s = 0
  initial body.mass.v = 25
