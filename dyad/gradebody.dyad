"Vehicle body on a slope, with aerodynamic drag and rolling resistance."
component GradeBody
  "Driving-force connection from the driveline."
  flange = Dyad.Flange() {^flange}
  "Road gradient: positive uphill; 0.02 means 2 percent."
  grade = Dyad.RealInput() {^grade}
  "Vehicle mass."
  mass = TranslationalComponents.Components.Mass(m = m) {^mass}
  "Aerodynamic resistance opposing vehicle motion."
  drag = TranslationalComponents.Sources.QuadraticSpeedDependentForce(ForceDirection = false, f_nominal = -0.5 * rho * CdA * v_nominal ^ 2, v_nominal = v_nominal) {^drag}
  "Resistance caused by tyre rolling losses."
  rolling = TranslationalComponents.Components.RollingResistance(fWeight = m * g) {^rolling}
  "Supplies the rolling resistance coefficient."
  cr_const = BlockComponents.Sources.Constant(k = f_r) {^cr_const}
  "Gravity force acting along the sloping road."
  gradeforce = mycar.GradeForce(m = m, g = g) {^gradeforce}
  "Fixed reference for the force-component supports."
  ground = TranslationalComponents.Components.Fixed() {^ground}
  "Vehicle mass in kg."
  parameter m::Dyad.Mass = 1400
  "Drag coefficient multiplied by frontal area, in m²."
  parameter CdA::Area = 0.63
  "Air density in kg/m³."
  parameter rho::Density = 1.2
  "Rolling resistance coefficient."
  parameter f_r::Real = 0.012
  "Gravitational acceleration in m/s²."
  parameter g::Acceleration = 9.80665
  "Reference speed for specifying aerodynamic drag, in m/s."
  parameter v_nominal::Velocity = 30
relations
  connect(flange, mass.flange_a, rolling.flange, drag.flange, gradeforce.flange) {^id9}
  connect(ground.flange, rolling.support, drag.support, gradeforce.support) {^id10}
  connect(cr_const.y, rolling.cr) {^id11}
  connect(grade, rolling.inclination, gradeforce.grade) {^id12}
