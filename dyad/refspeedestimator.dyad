component RefSpeedEstimator
  "Measured wheel angular speed [rad/s]"
  omega = RealInput() {^omega}
  "Estimated braking slip"
  kappa_hat = RealOutput() {^kappa_hat}
  "Estimated car speed [m/s]"
  v_ref = RealOutput() {^v_ref}
  "Wheel surface acceleration [m/s²]"
  a_w = RealOutput() {^a_w}

  "Wheel radius [m]"
  parameter radius::Length = 0.31
  "Assumed car deceleration while the wheel slips [m/s²]"
  parameter a_ref::Acceleration = 8
  "Starting speed: 90 km/h"
  parameter v0::Velocity = 25
  "How quickly the estimate follows a recovering wheel"
  parameter T_up::Time = 0.01
  "Minimum denominator for calculating slip"
  parameter v_eps::Velocity = 0.5
  "Wheel acceleration filtering time [s]"
  parameter T_f::Time = 0.005

  variable v_w::Velocity
  variable v_f::Velocity
relations
  v_w = omega * radius

  initial v_ref = v0
  der(v_ref) = ifelse(v_w > v_ref, (v_w - v_ref) / T_up, -a_ref)

  kappa_hat = (v_w - v_ref) / max(v_ref, v_eps)

  initial v_f = v0
  der(v_f) = (v_w - v_f) / T_f
  a_w = (v_w - v_f) / T_f
metadata {
  "_links": {
    "omega": {
      "Dyad": {"placement": {"icon": {
        "x1": -50, "x2": 50, "y1": 450, "y2": 550
      }}}
    },
    "kappa_hat": {
      "Dyad": {"placement": {"icon": {
        "x1": 950, "x2": 1050, "y1": 200, "y2": 300
      }}}
    },
    "v_ref": {
      "Dyad": {"placement": {"icon": {
        "x1": 950, "x2": 1050, "y1": 450, "y2": 550
      }}}
    },
    "a_w": {
      "Dyad": {"placement": {"icon": {
        "x1": 950, "x2": 1050, "y1": 700, "y2": 800
      }}}
    }
  }
}
end