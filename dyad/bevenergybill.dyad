
component BEVEnergyBill
  extends BEVWLTC

  # Power at the battery terminals, positive during discharge
  variable P_dc::Power

  # Mechanical power at the motor shaft
  variable P_shaft::Power

  # Energy supplied by the battery cells
  variable E_cells::Energy

  # Net energy at the battery terminals
  variable E_dc::Energy

  # Energy discharged and recovered
  variable E_dc_out::Energy
  variable E_dc_in::Energy

  # Energy lost through battery internal resistance
  variable E_R0::Energy

  # Energy used by auxiliary electrical systems
  variable E_aux::Energy

  # Converter and motor losses
  variable E_conv::Energy
  variable E_motor::Energy

  # Mechanical energy delivered and recovered at the motor shaft
  variable E_shaft_out::Energy
  variable E_shaft_in::Energy

  # Energy used to overcome road resistance
  variable E_road::Energy

  # Friction braking and tire-slip losses
  variable E_brake::Energy
  variable E_tire::Energy

  # Stored kinetic and magnetic energy
  variable E_kin::Energy

relations

  # Measure battery electrical power.
  P_dc = drive.battery.v * drive.battery.i

  # Measure mechanical power at the motor shaft.
  P_shaft = drive.machine.P_mech

  # Energy leaving the battery cells
  der(E_cells) = drive.battery.E * drive.battery.i

  # Net electrical energy at the battery terminals
  der(E_dc) = P_dc

  # Separate battery discharge and charging energy.
  der(E_dc_out) = max(P_dc, 0.0)
  der(E_dc_in) = max(-P_dc, 0.0)

  # Internal battery resistance losses
  der(E_R0) = drive.battery.R0 * drive.battery.i ^ 2

  # Auxiliary electrical consumption
  der(E_aux) = drive.aux.v * drive.aux.i

  # Converter and motor losses
  der(E_conv) = drive.converter.P_loss
  der(E_motor) = drive.machine.P_loss

  # Mechanical traction energy
  der(E_shaft_out) = max(P_shaft, 0.0)

  # Mechanical energy recovered during braking
  der(E_shaft_in) = max(-P_shaft, 0.0)

  # Road resistance losses
  der(E_road) = roadload.F * car.bus.vx

  # Energy dissipated by the four friction brakes
  der(E_brake) =
    car.fl.brake.tau_friction * car.fl.brake.w +
    car.fr.brake.tau_friction * car.fr.brake.w +
    car.rl.brake.tau_friction * car.rl.brake.w +
    car.rr.brake.tau_friction * car.rr.brake.w

  # Energy lost through longitudinal and lateral tire slip
  der(E_tire) =
    car.fl.joint.f_long * car.fl.joint.v_slip_long +
    car.fl.joint.f_lat * car.fl.joint.v_slip_lat +
    car.fr.joint.f_long * car.fr.joint.v_slip_long +
    car.fr.joint.f_lat * car.fr.joint.v_slip_lat +
    car.rl.joint.f_long * car.rl.joint.v_slip_long +
    car.rl.joint.f_lat * car.rl.joint.v_slip_lat +
    car.rr.joint.f_long * car.rr.joint.v_slip_long +
    car.rr.joint.f_lat * car.rr.joint.v_slip_lat

  # Kinetic energy of the vehicle body, wheels and motor rotor,
  # including magnetic energy stored in the motor inductance.
  E_kin =
    0.5 * m * (car.body.v[1] ^ 2 + car.body.v[2] ^ 2) +
    0.5 * car.Iz * car.body.w ^ 2 +
    0.5 * car.J * (
      car.fl.inertia.w ^ 2 +
      car.fr.inertia.w ^ 2 +
      car.rl.inertia.w ^ 2 +
      car.rr.inertia.w ^ 2
    ) +
    0.5 * drive.machine.J * drive.machine.rotor.w ^ 2 +
    0.5 * drive.machine.L * drive.machine.inductor.i ^ 2

  # All energy counters start from zero.
  initial E_cells = 0.0
  initial E_dc = 0.0
  initial E_dc_out = 0.0
  initial E_dc_in = 0.0
  initial E_R0 = 0.0
  initial E_aux = 0.0
  initial E_conv = 0.0
  initial E_motor = 0.0
  initial E_shaft_out = 0.0
  initial E_shaft_in = 0.0
  initial E_road = 0.0
  initial E_brake = 0.0
  initial E_tire = 0.0

end

analysis BEVEnergyBillTransient
  extends TransientAnalysis(
    stop = 1800.0,
    alg = ODEAlg.Rodas5P(),
    dtmax = 1.0,
    optimize = OptimizationLevel.None()
  )

  parameter k::Real = 50.0
  parameter Ti::Time = 2.0
  parameter v_fade::Real = 10.0
  parameter P_aux::Power = 300.0

  model = BEVEnergyBill(
    k = k,
    Ti = Ti,
    v_fade = v_fade,
    P_aux = P_aux
  )
end
