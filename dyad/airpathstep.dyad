component AirPathStep
  throttle_cmd = BlockComponents.Sources.Step(offset = 0, height = 1, start_time = 1) {^throttle_cmd}
  "3000 rpm"
  speed = BlockComponents.Sources.Constant(k = 314.159) {^speed}
  throttle = VehicleSystemsComponents.Vehicle.Engine.Throttle() {^throttle}
  cylinders = VehicleSystemsComponents.Vehicle.Engine.CylinderAirflow() {^cylinders}
  manifold = Manifold() {^manifold}
relations
  connect(throttle_cmd.y, throttle.u_thr) {^id6}
  connect(speed.y, cylinders.omega) {^id7}
  connect(throttle.mdot_thr, manifold.mdot_thr) {^id8}
  connect(cylinders.mdot_cyl, manifold.mdot_cyl) {^id9}
  connect(manifold.p_m, throttle.p_m, cylinders.p_m) {^id10}
  initial manifold.p = 101325
metadata {
  "_links": {
    "throttle_cmd": {"Dyad": {"placement": {"diagram": {"x1": 20, "x2": 120, "y1": 50, "y2": 150}}}},
    "speed": {
      "Dyad": {"placement": {"diagram": {"x1": 70, "x2": 170, "y1": 730, "y2": 830}}}
    },
    "throttle": {
      "Dyad": {"placement": {"diagram": {"x1": 390, "x2": 490, "y1": 70, "y2": 170}}}
    },
    "cylinders": {
      "Dyad": {"placement": {"diagram": {"x1": 340, "x2": 440, "y1": 690, "y2": 790}}}
    },
    "manifold": {
      "Dyad": {"placement": {"diagram": {"x1": 570, "x2": 710, "y1": 430, "y2": 570}}}
    },
    "id6": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}},
    "id7": {
      "Dyad": {
        "edges": [{"S": 1, "M": [{"x": 270, "y": 780}, {"x": 270, "y": 760}], "E": 2}],
        "path": {}
      }
    },
    "id8": {
      "Dyad": {
        "edges": [{"S": 1, "M": [{"x": 530, "y": 120}, {"x": 530, "y": 465}], "E": 2}],
        "path": {}
      }
    },
    "id9": {
      "Dyad": {
        "edges": [{"S": 1, "M": [{"x": 510, "y": 740}, {"x": 510, "y": 535}], "E": 2}],
        "path": {}
      }
    },
    "id10": {
      "Dyad": {
        "edges": [
          {"S": 1, "M": [{"x": 750, "y": 500}], "E": -1},
          {
            "S": -1,
            "M": [{"x": 750, "y": 260}, {"x": 360, "y": 260}, {"x": 360, "y": 140}],
            "E": 2
          },
          {
            "S": -1,
            "M": [{"x": 750, "y": 650}, {"x": 210, "y": 650}, {"x": 210, "y": 720}],
            "E": 3
          }
        ],
        "junctions": [{"x": 750, "y": 500}],
