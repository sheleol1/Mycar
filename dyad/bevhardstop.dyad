component BEVHardStop
  # Vehicle mass and wheel radius
  parameter m::Mass = 1500.0
  parameter radius::Length = 0.31
  # Initial speed: 80 km/h
  parameter v0::Velocity = 22.22222222222222
  # Emergency braking demand
  parameter T_cmd::Torque = 2500.0
  # Braking starts after 0.5 seconds.
  parameter brake_time::Time = 0.5
  # The brake pedal is applied over 0.1 seconds.
  parameter t_apply::Time = 0.1
  # Electric motor and battery limits
  parameter tau_max::Torque = 320.0
  parameter P_charge::Power = 80.5e3
  parameter v_fade::Real = 10.0
  # Auxiliary electrical power
  parameter P_aux::Power = 300.0
  # Nissan Leaf reduction ratio
  parameter ratio::Real = 8.193
  # ABS coordination and road friction
  parameter withdraw::Real = 1.0
  parameter road_mu::Real = 1.0
  # Apply the braking demand gradually.
  pedal = BlockComponents.Sources.Ramp(offset = 0.0, height = -4.0 * T_cmd / ratio, duration = t_apply, start_time = brake_time) {^pedal}
  # Convert vehicle speed to km/h.
  kmh = VehicleSystemsComponents.Vehicle.ToKmPerHour() {^kmh}
  # Distribute braking torque between the motor and friction brakes.
  blend = RegenBlend(ratio = ratio, radius = radius, tau_max = tau_max, P_charge = P_charge, v_fade = v_fade, abs_rule = true, withdraw = withdraw) {^blend}
  # Electric drivetrain from Step 04
  drive = ElectricDrive(ratio = ratio, P_aux = P_aux) {^drive}
  # Front differential and fixed supports
  differential = MultibodyComponents.PlanarMechanics.DifferentialGear() {^differential}
  mount = RotationalComponents.Components.Fixed() {^mount}
  straight = RotationalComponents.Components.Fixed() {^straight}
  zero = BlockComponents.Sources.Constant(k = 0.0) {^zero}
  # ABS controller
  abs = VehicleSystemsComponents.Vehicle.Planar.ABSUnit(select_low = 0.0, report_front = true) {^abs}
  # Vehicle model with adjustable road grip
  car = VehicleSystemsComponents.Vehicle.Planar.PlanarCar(m = m, radius = radius, mu_scale_fl = road_mu, mu_scale_fr = road_mu, mu_scale_rl = road_mu, mu_scale_rr = road_mu) {^car}
  # Read vehicle motion and wheel slips.
  motion = VehicleSystemsComponents.Vehicle.Planar.BusMotion() {^motion}
  slips = VehicleSystemsComponents.Vehicle.Planar.BusSlip() {^slips}
  # Electrical and mechanical power
  variable P_dc::Power
  variable P_shaft::Power
  # Energy recovered by the battery and motor
  variable E_dc_in::Energy
  variable E_shaft_in::Energy
  # Energy dissipated by friction brakes
  variable E_brake::Energy
relations
  # Read vehicle speed and wheel-slip information.
  connect(car.bus, motion.bus, slips.bus) {^id13}
  # Send the braking demand to the blending controller.
  connect(pedal.y, blend.tau_ref) {^id14}
  # Vehicle speed is used by ABS and regenerative braking.
  connect(motion.vx, kmh.u, abs.vx) {^id15}
  connect(kmh.y, blend.v) {^id16}
  # Motor receives its share of the braking torque.
  connect(blend.tau_motor, drive.tau_ref) {^id17}
  # Remaining braking demand is controlled by ABS.
  connect(blend.tau_brake, abs.demand) {^id18}
  # Transfer mechanical torque to the front wheels.
  connect(drive.spline, differential.flange_b) {^id19}
  connect(differential.flange_left, car.spin_fl) {^id20}
  connect(differential.flange_right, car.spin_fr) {^id21}
  # Fix the drivetrain housing and steering.
  connect(drive.support, mount.spline) {^id22}
  connect(car.steering, straight.spline) {^id23}
  # No additional ESP torque is requested.
  connect(zero.y, abs.dT_fl, abs.dT_fr, abs.dT_rl, abs.dT_rr) {^id24}
  # ABS receives slip information from all four wheels.
  connect(slips.kappa_fl, abs.kappa_fl) {^id25}
  connect(slips.kappa_fr, abs.kappa_fr) {^id26}
  connect(slips.kappa_rl, abs.kappa_rl) {^id27}
  connect(slips.kappa_rr, abs.kappa_rr) {^id28}
  # ABS controls friction braking at each wheel.
  connect(abs.tau_fl, car.tau_fl) {^id29}
  connect(abs.tau_fr, car.tau_fr) {^id30}
  connect(abs.tau_rl, car.tau_rl) {^id31}
  connect(abs.tau_rr, car.tau_rr) {^id32}
  # Reduce regenerative braking when the front ABS is active.
  connect(abs.front_active, blend.abs_active) {^id33}
  # Measure electrical power at the battery.
  P_dc = drive.battery.v * drive.battery.i
  # Measure mechanical power at the motor shaft.
  P_shaft = drive.machine.P_mech
  # Integrate the recovered electrical and mechanical energy.
  der(E_dc_in) = max(-P_dc, 0.0)
  der(E_shaft_in) = max(-P_shaft, 0.0)
  # Calculate energy dissipated by all four friction brakes.
  der(E_brake) = car.fl.brake.tau_friction * car.fl.brake.w + car.fr.brake.tau_friction * car.fr.brake.w + car.rl.brake.tau_friction * car.rl.brake.w + car.rr.brake.tau_friction * car.rr.brake.w
  # Initial vehicle position and speed
  initial car.body.r = [0, 0]
  initial car.body.v = [v0, 0]
  initial car.body.phi = 0.0
  initial car.body.w = 0.0
  # Initial wheel speeds
  initial car.fl.inertia.w = (v0 + 0.01) / radius
  initial car.fr.inertia.w = (v0 + 0.01) / radius
  initial car.rl.inertia.w = (v0 + 0.01) / radius
  initial car.rr.inertia.w = (v0 + 0.01) / radius
  # Initial wheel positions
  initial car.fl.inertia.phi = 0.0
  initial car.fr.inertia.phi = 0.0
  initial car.rl.inertia.phi = 0.0
  initial car.rr.inertia.phi = 0.0
  # Brakes start without applied torque.
  initial car.fl.brake.tau_actual = 0.0
  initial car.fr.brake.tau_actual = 0.0
  initial car.rl.brake.tau_actual = 0.0
  initial car.rr.brake.tau_actual = 0.0
  # Initial converter current
  initial drive.converter.i_out = 0.0
  # Energy counters start at zero.
  initial E_dc_in = 0.0
  initial E_shaft_in = 0.0
  initial E_brake = 0.0
