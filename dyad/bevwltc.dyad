end

analysis BEVWLTCTransient
  extends TransientAnalysis(
    stop = 1800.0,
    alg = ODEAlg.Rodas5P(),
    dtmax = 1.0,
    optimize = OptimizationLevel.None()
  )

  parameter k::Real = 50.0
  parameter Ti::Time = 2.0
  parameter v_fade::Real = 10.0
  parameter P_aux::Power = 300.0

  model = BEVWLTC(
    k = k,
    Ti = Ti,
    v_fade = v_fade,
    P_aux = P_aux
  )
end
