
component BEVWLTC

  # Vehicle parameters
  parameter m::Mass = 1500.0
  parameter radius::Length = 0.31

  # PI controller settings
  parameter k::Real = 50.0
  parameter Ti::Time = 2.0

  # Motor torque limit
  parameter tau_max::Torque = 320.0

  # Regenerative braking fades below this speed
  parameter v_fade::Real = 10.0

  # Power used by auxiliary electrical systems
  parameter P_aux::Power = 300.0

  # Nissan Leaf reduction ratio
  parameter ratio::Real = 8.193

  # Small initial wheel speed to avoid zero-slip problems
  parameter dv_wheel::Velocity = 0.01

  # WLTC speed reference
  trace = VehicleSystemsComponents.Vehicle.DriveCycle() {^trace}

  # PI controller follows the required vehicle speed
  driver = BlockComponents.Continuous.LimPID(
    with_D = false,
    k = k,
    Ti = Ti,
    y_max = tau_max,
    y_min = -tau_max
  ) {^driver}

  no_ff = BlockComponents.Sources.Constant(k = 0.0) {^no_ff}

  # Convert measured speed from m/s to km/h
  kmh = VehicleSystemsComponents.Vehicle.ToKmPerHour() {^kmh}

  # Share the requested torque between motor and brakes
  split = VehicleSystemsComponents.Vehicle.Electric.TorqueSplit(
    ratio = ratio,
    v_fade = v_fade
  ) {^split}

  # Electric drivetrain from the previous part
  drive = ElectricDrive(
    ratio = ratio,
    P_aux = P_aux
  ) {^drive}

  # Differential distributes torque to the front wheels
  differential = MultibodyComponents.PlanarMechanics.DifferentialGear() {^differential}

  # Fixed supports
  mount = RotationalComponents.Components.Fixed() {^mount}
  straight = RotationalComponents.Components.Fixed() {^straight}

  flat = BlockComponents.Sources.Constant(k = 0.0) {^flat}

  # Vehicle and road resistance
  car = VehicleSystemsComponents.Vehicle.Planar.PlanarCar(
    m = m,
    radius = radius
  ) {^car}

  motion = VehicleSystemsComponents.Vehicle.Planar.BusMotion() {^motion}

  roadload = VehicleSystemsComponents.Vehicle.Planar.PlanarRoadLoad(
    m = m
  ) {^roadload}

relations

  # Read the vehicle motion from the car bus.
  connect(car.bus, motion.bus) {^wbus}

  # Compare the WLTC reference with actual vehicle speed.
  connect(trace.y, driver.u_s) {^w1}
  connect(motion.vx, kmh.u) {^w2}
  connect(kmh.y, driver.u_m, split.v) {^w3}
  connect(no_ff.y, driver.u_ff) {^w4}

  # Send the requested torque to the torque splitter.
  connect(driver.y, split.tau_ref) {^w5}

  # Motor torque is sent to the electric drivetrain.
  connect(split.tau_motor, drive.tau_ref) {^w6}

  # Remaining braking torque goes to the front brakes.
  connect(split.tau_brake, car.tau_fl, car.tau_fr) {^w7}

  # Transfer motor torque through the differential.
  connect(drive.spline, differential.flange_b) {^w8}
  connect(differential.flange_left, car.spin_fl) {^w9}
  connect(differential.flange_right, car.spin_fr) {^w10}

  # Hold the drivetrain housing in place.
  connect(drive.support, mount.spline) {^w11}

  # Keep steering fixed during the driving cycle.
  connect(car.steering, straight.spline) {^w12}

  # Simulate a flat road.
  connect(flat.y, roadload.grade) {^w13}
  connect(car.chassis, roadload.chassis) {^w14}

  # Rear friction brakes are not used in this bench.
  car.tau_rl = 0.0
  car.tau_rr = 0.0

  # Initial vehicle position and speed
  initial car.body.r = [0, 0]
  initial car.body.v = [0, 0]
  initial car.body.phi = 0.0
  initial car.body.w = 0.0

  # Initial wheel speeds
  initial car.fl.inertia.w = dv_wheel / radius
  initial car.fr.inertia.w = dv_wheel / radius
  initial car.rl.inertia.w = dv_wheel / radius
  initial car.rr.inertia.w = dv_wheel / radius

  # Initial wheel angles
  initial car.fl.inertia.phi = 0.0
  initial car.fr.inertia.phi = 0.0
  initial car.rl.inertia.phi = 0.0
  initial car.rr.inertia.phi = 0.0

  # Brakes start without applied torque.
  initial car.fl.brake.tau_actual = 0.0
  initial car.fr.brake.tau_actual = 0.0
  initial car.rl.brake.tau_actual = 0.0
  initial car.rr.brake.tau_actual = 0.0

  # The converter starts with zero output current.
  initial drive.converter.i_out = 0.0

