component Battery
  "Positive electrical terminal"
  p = Pin() {^p}
  "Negative electrical terminal"
  n = Pin() {^n}
  # The voltage source represents the battery cells.
  ocv = BlockComponents.Sources.Constant(k = E) {^ocv}
  cell = ElectricalComponents.Analog.Sources.VoltageSource() {^cell}
  # Internal resistance causes voltage drop and energy losses.
  resistor = ElectricalComponents.Analog.Basic.Resistor(R = R0) {^resistor}
  # Measure current to calculate the remaining charge.
  meter = ElectricalComponents.Analog.Sensors.CurrentSensor() {^meter}
  counter = BlockComponents.Continuous.Integrator(k = -1 / Q_nom, x0 = SoC0) {^counter}
  "Battery state of charge"
  SoC = RealOutput() {^SoC}
  # Nissan Leaf ZE1 battery parameters
  parameter E::Voltage = 350.0
  parameter R0::Resistance = 0.1
  parameter Q_nom::ElectricCharge = 40.0e3 * 3600.0 / 350.0
  parameter SoC0::Real = 0.9
  "Voltage measured across the battery terminals"
  variable v::Voltage
  "Current leaving the battery during discharge"
  variable i::Current
relations
  # Supply the cell with its open-circuit voltage.
  connect(ocv.y, cell.V) {^id9}
  # Electrical path through the battery.
  connect(n, cell.n) {^id10}
  connect(cell.p, resistor.p) {^id11}
  connect(resistor.n, meter.p) {^id12}
  connect(meter.n, p) {^id13}
  # Use the measured current to calculate the state of charge.
  connect(meter.i, counter.u) {^id14}
  connect(counter.y, SoC) {^id15}
  # Values used later in the electric vehicle model.
  v = p.v - n.v
  i = meter.i
