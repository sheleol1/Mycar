    },
    "friction": {
      "Dyad": {"placement": {"diagram": {"x1": 90, "x2": 190, "y1": 430, "y2": 530}}}
    },
    "car": {
      "Dyad": {"placement": {"diagram": {"x1": 620, "x2": 820, "y1": 410, "y2": 610}}}
    },
    "id5": {
