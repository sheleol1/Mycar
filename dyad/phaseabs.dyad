component PhaseABS
  "Estimated wheel slip"
  kappa = RealInput() {^kappa}
  "Wheel surface acceleration [m/s²]"
  a_w = RealInput() {^a_w}
  "Estimated car speed [m/s]"
  v = RealInput() {^v}
  "Driver's requested brake pressure [Pa]"
  demand = RealInput() {^demand}
  "Allowed brake pressure [Pa]"
  p_cmd = RealOutput() {^p_cmd}

  pressure = VehicleSystemsComponents.Vehicle.ABSPressureIntegrator(T_track = 0.01) {^pressure}

  "Release pressure below this wheel acceleration"
  parameter a_minus::Acceleration = 12
  "Hold pressure above this wheel acceleration"
  parameter a_plus::Acceleration = 3
  "Estimated braking slip that triggers release"
  parameter lambda_1::Real = 0.2
  "Pressure release rate [Pa/s]"
  parameter k_dec::Real = 5.8e7
  "Pressure rebuild rate [Pa/s]"
  parameter k_inc::Real = 1.16e7
  "Disable ABS below this speed [m/s]"
  parameter v_min::Velocity = 1.5
  "Activation latch time [s]"
  parameter T_latch::Time = 0.001

  "-1 release, 0 hold, +1 increase"
  variable phase::Real
  "Remembers that ABS has activated"
  variable cycled::Real
relations
  phase = ifelse(a_w > a_plus, 0,
    ifelse(a_w < -a_minus or kappa < -lambda_1, -1, 1))

  initial cycled = 0
  der(cycled) = ifelse(phase < -0.5, (1 - cycled) / T_latch, 0)

  connect(demand, pressure.demand) {^id1}

  pressure.requested_rate = ifelse(phase < -0.5, -k_dec,
    ifelse(phase < 0.5, 0, k_inc))

  pressure.active = ifelse(v > v_min and cycled > 0.5, 1.0, 0.0)
  p_cmd = ifelse(cycled > 0.5, pressure.cmd, demand)
metadata {
  "_links": {
    "kappa": {
      "Dyad": {"placement": {
        "icon": {"x1": -50, "x2": 50, "y1": 100, "y2": 200},
        "diagram": {"x1": -50, "x2": 50, "y1": 100, "y2": 200}
      }}
    },
    "a_w": {
