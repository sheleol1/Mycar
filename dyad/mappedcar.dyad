component MappedCar
  "Initial engine-to-wheel ratio"
  parameter ratio_initial::Real = 12
  pedal = RealInput() {^pedal}
  v_kmh = RealOutput() {^v_kmh}
  p_m = RealOutput() {^p_m}
  fuel_lph = RealOutput() {^fuel_lph}
  engine = MapEngine() {^engine}
  "Engine rotational inertia [kg.m²]"
  flywheel = RotationalComponents.Components.Inertia(J = 0.15) {^flywheel}
  driveline = VehicleSystemsComponents.Vehicle.CVTDriveline(ratio_initial = ratio_initial) {^driveline}
  body = Body() {^body}
  vsensor = TranslationalComponents.Sensors.VelocitySensor() {^vsensor}
  to_kmh = BlockComponents.Math.Gain(k = 3.6) {^to_kmh}
  to_lph = BlockComponents.Math.Gain(k = 4832.2) {^to_lph}
  rot_ground = RotationalComponents.Components.Fixed() {^rot_ground}
  trans_ground = TranslationalComponents.Components.Fixed() {^trans_ground}
    "Requested braking force [N]"
  F_brake = RealInput()

  "Wheel brake acting between the car and the road"
  brake = VehicleSystemsComponents.Vehicle.RoadBrake()
relations
  connect(pedal, engine.pedal) {^id14}
  connect(pedal, driveline.pedal) {^id15}
  connect(engine.spline, flywheel.spline_a) {^id16}
  connect(flywheel.spline_b, driveline.spline) {^id17}
  connect(engine.support, rot_ground.spline) {^id18}
  connect(driveline.support_r, rot_ground.spline) {^id19}
  connect(driveline.flange, body.flange) {^id20}
  connect(driveline.support_t, trans_ground.flange) {^id21}
  connect(vsensor.flange, body.flange) {^id22}
  connect(vsensor.v, to_kmh.u) {^id23}
  connect(to_kmh.y, v_kmh) {^id24}
  connect(engine.p_m, p_m) {^id25}
  connect(engine.mdot_fuel, to_lph.u) {^id26}
  connect(to_lph.y, fuel_lph) {^id27}
  connect(F_brake, brake.F_cmd)
  connect(brake.flange, body.flange)
  connect(brake.support, trans_ground.flange)
