component ElectricDrive
  "Requested motor torque"
  tau_ref = RealInput() {^tau_ref}
  "Output shaft connected to the differential"
  spline = Spline() {^spline}
  "Motor housing and gearbox support"
  support = Spline() {^support}
  "Battery state of charge"
  SoC = RealOutput() {^SoC}
  # Battery and electrical components
  battery = Battery() {^battery}
  aux = VehicleSystemsComponents.Vehicle.Electric.AuxLoad(P_aux = P_aux) {^aux}
  converter = Converter() {^converter}
  # Motor with field weakening enabled
  machine = DCMachine(field_weakening = true) {^machine}
  ground = ElectricalComponents.Analog.Basic.Ground() {^ground}
  # Reduction gear between the motor and differential
  reduction = RotationalComponents.Components.IdealGear(ratio = ratio) {^reduction}
  # Nissan Leaf ZE1 reduction ratio
  parameter ratio::Real = 8.193
  # Electrical power used by auxiliary systems
  parameter P_aux::Power = 300.0
relations
  # The battery supplies the converter and auxiliary systems.
  connect(battery.p, converter.p_in, aux.p) {^id11}
  # Common negative electrical connection
  connect(battery.n, converter.n, aux.n, machine.n, ground.g) {^id12}
  # The converter supplies controlled current to the motor.
  connect(converter.p_out, machine.p) {^id13}
  # Field weakening adjusts the motor at higher speeds.
  connect(converter.field, machine.field) {^id14}
  # Transfer motor torque through the reduction gear.
  connect(machine.spline, reduction.spline_a) {^id15}
  connect(reduction.spline_b, spline) {^id16}
  # Hold the motor housing and gearbox in place.
  connect(machine.support, reduction.support, support) {^id17}
  # Make the battery charge available to the vehicle model.
  connect(battery.SoC, SoC) {^id18}
  # Convert requested motor torque into a current reference.
  converter.i_ref = tau_ref / (converter.field * machine.k)
