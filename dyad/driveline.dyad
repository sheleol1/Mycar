"Gearbox and rolling wheel: engine shaft in, tractive force on the body out."
component Driveline
  "From the engine"
  spline = Dyad.Spline() {^spline}
  "Gearbox housing"
  support_r = Dyad.Spline() {^support_r}
  "To the body"
  flange = Dyad.Flange() {^flange}
  "Road"
  support_t = Dyad.Flange() {^support_t}
  gear = RotationalComponents.Components.IdealGear(ratio = i) {^gear}
  wheel = RotationalComponents.Components.IdealRollingWheel(radius = r) {^wheel}
  "Gear ratio"
  parameter i::Real = 4.0
  "Wheel rolling radius"
  parameter r::Length = 0.31
relations
  connect(gear.spline_a, spline) {^id7}
  connect(gear.support, support_r) {^id8}
  connect(wheel.support_r, gear.support) {^id9}
  connect(gear.spline_b, wheel.spline) {^id10}
  connect(wheel.flange, flange) {^id11}
  connect(wheel.support_t, support_t) {^id12}
